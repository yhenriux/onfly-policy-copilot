# Application
APP_NAME=Onfly Policy Copilot
APP_VERSION=1.0.0
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
WEB_ROOT=app/web
AUTH_USERS_PATH=data/auth/mock_users.json
AUTH_TOKEN_SECRET=change-this-local-demo-secret
AUTH_TOKEN_TTL_SECONDS=3600

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=all-minilm
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_RETRY_ATTEMPTS=3
OLLAMA_RETRY_BACKOFF_SECONDS=0.25
LLM_INTEGRATION=langchain
WORKFLOW_ENGINE=langgraph

# LangSmith é opcional. Mantenha false para não enviar traces a um serviço externo.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=onfly-policy-copilot

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_MODE=local
QDRANT_PATH=.local/qdrant
QDRANT_COLLECTION=onfly_policy_documents_phase2
# Defina somente no arquivo .env local quando a instância exigir autenticação.
QDRANT_API_KEY=
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=onfly.ingestion
RABBITMQ_QUEUE=onfly.ingestion.jobs
RABBITMQ_DEAD_LETTER_QUEUE=onfly.ingestion.dead-letter
RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_RETRY_ATTEMPTS=3
RABBITMQ_RETRY_DELAY_SECONDS=5
REDIS_URL=redis://localhost:6379/0
REDIS_JOB_TTL_SECONDS=86400
INGESTION_STORAGE_PATH=.local/ingestion
INGESTION_MAX_FILE_BYTES=10000000

# Retrieval
RETRIEVAL_TOP_K=10
CONTEXT_TOP_K=10
RRF_K=60
DENSE_WEIGHT=1.0
LEXICAL_WEIGHT=1.0
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANK_TOP_N=10
MAX_CONTEXT_CHARACTERS=5000
CONTEXT_REDUNDANCY_THRESHOLD=0.8
EVIDENCE_MIN_SCORE=0.5
GENERATION_MAX_EVIDENCE_CHUNKS=1

# Chunking
# Chunking significa dividir um documento em trechos menores para pesquisa.
CHUNK_MAX_CHARS=800
CHUNK_OVERLAP_CHARS=120

# Security and request limits
MAX_QUESTION_LENGTH=2000
